platform :ios, '15.0'
ENV['COCOAPODS_DISABLE_STATS'] = '1'
def firebase_sdk_version; '11.14.0'; end
install! 'cocoapods'
project 'Runner', { 'Debug' => :debug, 'Release' => :release, 'Profile' => :profile }
def flutter_root
  return ENV['FLUTTER_ROOT'] if ENV['FLUTTER_ROOT']
  path = File.expand_path('Flutter/Generated.xcconfig', __dir__)
  if File.exist?(path)
    File.foreach(path) { |l| m = l.match(/\A\s*FLUTTER_ROOT\s*=\s*["']?(.*?)["']?\s*\z/); return m[1] if m }
  end
  return '/Users/builder/programs/flutter' if File.exist?('/Users/builder/programs/flutter')
  raise "FLUTTER_ROOT not found."
end
require File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb')
target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(__FILE__)
end
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', 'PERMISSION_NOTIFICATIONS=1']
    end
  end
end
