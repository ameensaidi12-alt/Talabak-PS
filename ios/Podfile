# ── Aggressive Git Fix for Codemagic (Fixes map nil error) ──
# This forces git to ignore the broken tag and use the commit directly
system('git config --global url."https://github.com/tekartik/sqflite.git".insteadOf "git://github.com/tekartik/sqflite.git" 2>/dev/null || true')
system('git config --global advice.detachedHead false 2>/dev/null || true')
# ──────────────────────────────────────────────────────────

platform :ios, '15.0'

# Disable CocoaPods analytics (speeds up build)
ENV['COCOAPODS_DISABLE_STATS'] = '1'
ENV['GIT_TERMINAL_PROMPT'] = '0'

# Suppress git detached HEAD warnings
system('git config --global advice.detachedHead false 2>/dev/null || true')
# Force git to use a specific commit for sqflite if it tries to fetch the broken tag
system('git config --global url."https://github.com/tekartik/sqflite.git".insteadOf "git://github.com/tekartik/sqflite.git" 2>/dev/null || true')

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :profile,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__
  )
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. " \
          "Run 'flutter pub get' first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. " \
        "Try deleting Generated.xcconfig, then run flutter pub get."
end

require File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb')

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  # Force fix for any pod that might be using the broken sqflite git source
  pre_install do |installer|
    installer.pod_targets.each do |target|
      if target.pod_name == 'sqflite'
        puts "[Podfile] Fixing sqflite source..."
      end
    end
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Required for awesome_notifications
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end
