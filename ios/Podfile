platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting build performance.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

# Manually define Firebase SDK version to fix the 'nil' error in firebase_core
def firebase_sdk_version
  '11.14.0'
end

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :profile,
}

def flutter_root
  # Try to get from environment first (Standard on CI like Codemagic)
  return ENV['FLUTTER_ROOT'] if ENV['FLUTTER_ROOT']

  generated_xcode_build_settings_path = File.expand_path('Flutter/Generated.xcconfig', __dir__)
  if File.exist?(generated_xcode_build_settings_path)
    File.foreach(generated_xcode_build_settings_path) do |line|
      # Support different formats: FLUTTER_ROOT=path, FLUTTER_ROOT = path, FLUTTER_ROOT="path"
      matches = line.match(/\A\s*FLUTTER_ROOT\s*=\s*["']?(.*?)["']?\s*\z/)
      return matches[1] if matches
    end
  end
  
  # Fallback for Codemagic default path if all else fails
  return '/Users/builder/programs/flutter' if File.exist?('/Users/builder/programs/flutter')
  
  raise "FLUTTER_ROOT not found. Please ensure flutter pub get has been run."
end

# USE THE OFFICIAL FLUTTER PODHELPER FROM THE SDK
flutter_install_utils_path = File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb')
unless File.exist?(flutter_install_utils_path)
  raise "Could not find podhelper.rb at #{flutter_install_utils_path}"
end
require flutter_install_utils_path

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(__FILE__)
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', 'PERMISSION_NOTIFICATIONS=1']
    end
  end
end
