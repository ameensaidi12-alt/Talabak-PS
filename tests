  Widget _buildPaymentsTab(ScrollController sc) {
    if (_paymentRecords.isEmpty) {
      return Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Icon(Icons.payments_outlined, color: Colors.white12, size: 64),
            const SizedBox(height: 16),
            Text("لا يوجد دفعات مسجلة بعد", style: GoogleFonts.cairo(color: Colors.white38, fontSize: 15)),
            const SizedBox(height: 8),
            Text("اضغط \"تسجيل دفعة\" لإضافة أول دفعة", style: GoogleFonts.cairo(color: Colors.white24, fontSize: 12)),
          ],
        ),
      );
    }

    return ListView.builder(
      controller: sc,
      padding: const EdgeInsets.fromLTRB(16, 16, 16, 80),
      itemCount: _paymentRecords.length,
      itemBuilder: (context, index) {
        final p = _paymentRecords[index];
        final dateStr = p['payment_date'] ?? '';
        String formattedDate = dateStr;
        String dayName = '';
        try {
          final d = DateTime.parse(dateStr);
          formattedDate = intl.DateFormat('dd MMMM yyyy', 'ar').format(d);
          dayName = intl.DateFormat('EEEE', 'ar').format(d);
        } catch (_) {}
        final notes = p['notes'];

        return Dismissible(
          key: Key(p['id'].toString()),
          direction: DismissDirection.startToEnd,
          background: Container(
            margin: const EdgeInsets.only(bottom: 10),
            decoration: BoxDecoration(color: Colors.red.withOpacity(0.2), borderRadius: BorderRadius.circular(14)),
            alignment: Alignment.centerLeft,
            padding: const EdgeInsets.only(left: 20),
            child: const Icon(Icons.delete_outline, color: Colors.red),
          ),
          confirmDismiss: (_) async {
            await _deleteRecord(p['id'].toString());
            return false; // we handle deletion ourselves
          },
          child: Container(
            margin: const EdgeInsets.only(bottom: 10),
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(
              color: Colors.green.withOpacity(0.05),
              borderRadius: BorderRadius.circular(14),
              border: Border.all(color: Colors.green.withOpacity(0.2)),
            ),
            child: Row(
              children: [
                // Timeline dot
                Column(
                  children: [
                    Container(
                      width: 36, height: 36,
                      decoration: BoxDecoration(color: Colors.green.withOpacity(0.15), shape: BoxShape.circle),
                      child: const Icon(Icons.payments_outlined, color: Colors.green, size: 18),
                    ),
                  ],
