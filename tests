class AreaRevenueScreen extends StatefulWidget {
  const AreaRevenueScreen({super.key});

  @override
  State<AreaRevenueScreen> createState() => _AreaRevenueScreenState();
}

class _AreaRevenueScreenState extends State<AreaRevenueScreen> {
  final _supabaseService = SupabaseService();
  bool _isLoading = true;
  bool _showOnlyMainAreas = true;
  List<Map<String, dynamic>> _areaStats = [];
  DateTimeRange? _dateRange;
  double _globalLifetimeProfit = 0;
  Map<String, String> _lastAreaPayments = {};
  Map<String, dynamic>? _currentUserProfile;
  
  @override
  void initState() {
    super.initState();
    // تحديث تلقائي عند فتح الصفحة
    _loadData();
  }

  Future<void> _loadData() async {
    if (!mounted) return;
    setState(() => _isLoading = true);
    try {
      final user = _supabaseService.client.auth.currentUser;
      if (user != null && _currentUserProfile == null) {
        _currentUserProfile = await _supabaseService.client.from('profiles').select().eq('id', user.id).single();
      }

      var areas = await _supabaseService.getDeliveryAreas();
      
      if (_currentUserProfile != null && _currentUserProfile!['role'] == 'supervisor') {
        final assignedId = _currentUserProfile!['assigned_area_id']?.toString();
        if (assignedId != null) {
          List<String> getAllSubAreaIds(String pid) {
            List<String> ids = [pid];
            final children = areas.where((a) => a['parent_id']?.toString() == pid);
            for (var child in children) {
              ids.addAll(getAllSubAreaIds(child['id'].toString()));
            }
            return ids;
          }
          final allAssignedIds = getAllSubAreaIds(assignedId);
          areas = areas.where((a) => allAssignedIds.contains(a['id'].toString())).toList();
        } else {
          areas = [];
        }
      }
      
      var ordersQuery = _supabaseService.client
          .from('orders')
          .select('subtotal, commission_rate, vendor_id, vendors(area_id)')
          .eq('status', 'delivered');
      
      if (_dateRange != null) {
        ordersQuery = ordersQuery
            .gte('created_at', _dateRange!.start.toIso8601String())
            .lte('created_at', _dateRange!.end.add(const Duration(days: 1)).toIso8601String());
      }

      final ordersResponse = await ordersQuery;
      final List<dynamic> orders = ordersResponse as List;
      
      final areaRevenue = <String, double>{};
      final areaProfit = <String, double>{};
      final areaVendorCount = <String, int>{};
      final areaDebt = <String, double>{};

      final allAreasRes = await _supabaseService.getDeliveryAreas();
      final List<Map<String, dynamic>> allAreas = List<Map<String, dynamic>>.from(allAreasRes);
      for (var area in allAreas) {
        final aid = area['id'].toString();
        areaRevenue[aid] = 0; areaProfit[aid] = 0; areaVendorCount[aid] = 0; areaDebt[aid] = 0;
      }

      for (var order in orders) {
        final subtotal = (order['subtotal'] as num? ?? 0).toDouble();
        final rate = (order['commission_rate'] as num? ?? 0).toDouble();
        final aid = order['vendors']?['area_id']?.toString();
        if (aid != null) {
          areaRevenue[aid] = (areaRevenue[aid] ?? 0) + subtotal;
          areaProfit[aid] = (areaProfit[aid] ?? 0) + (subtotal * rate / 100);
        }
      }

      final vendorsFinanceRes = await _supabaseService.client.from('vendors').select('id, area_id, current_balance');
      for (var v in (vendorsFinanceRes as List)) {
        final aid = v['area_id']?.toString();
        final bal = (v['current_balance'] as num? ?? 0).toDouble();
        if (aid != null) {
          areaVendorCount[aid] = (areaVendorCount[aid] ?? 0) + 1;
          if (bal < 0) areaDebt[aid] = (areaDebt[aid] ?? 0) + bal.abs();
        }
      }

      Map<String, double> recursiveRevenue = Map.from(areaRevenue);
      Map<String, double> recursiveProfit = Map.from(areaProfit);
      Map<String, int> recursiveVendors = Map.from(areaVendorCount);
      Map<String, double> recursiveDebt = Map.from(areaDebt);

      void propagateStats(String parentId) {
        final children = allAreas.where((a) => a['parent_id']?.toString() == parentId);
        for (var child in children) {
          final cid = child['id'].toString();
          propagateStats(cid);
          recursiveRevenue[parentId] = (recursiveRevenue[parentId] ?? 0) + (recursiveRevenue[cid] ?? 0);
          recursiveProfit[parentId] = (recursiveProfit[parentId] ?? 0) + (recursiveProfit[cid] ?? 0);
          recursiveVendors[parentId] = (recursiveVendors[parentId] ?? 0) + (recursiveVendors[cid] ?? 0);
          recursiveDebt[parentId] = (recursiveDebt[parentId] ?? 0) + (recursiveDebt[cid] ?? 0);
        }
      }

      final rootAreas = allAreas.where((a) => a['parent_id'] == null).toList();
      for (var root in rootAreas) propagateStats(root['id'].toString());

      double globalProfit = 0;
      var oQuery = _supabaseService.client.from('orders').select('subtotal, commission_rate, vendors!inner(area_id)').eq('status', 'delivered');
      final visibleAreaIds = areas.map((a) => a['id'].toString()).toList();
      if (_currentUserProfile != null && _currentUserProfile!['role'] == 'supervisor' && visibleAreaIds.isNotEmpty) {
        oQuery = oQuery.inFilter('vendors.area_id', visibleAreaIds);
      }
      final ordersSumRes = await oQuery;
      for (var o in (ordersSumRes as List)) {
        globalProfit += ((o['subtotal'] as num? ?? 0).toDouble() * (o['commission_rate'] as num? ?? 0).toDouble() / 100);
      }

      final areaPaymentsRes = await _supabaseService.client.from('area_payment_records').select('area_id, payment_date').order('payment_date', ascending: false);
      final lastPayments = <String, String>{};
      for (var p in (areaPaymentsRes as List)) {
        if (!lastPayments.containsKey(p['area_id'].toString())) lastPayments[p['area_id'].toString()] = p['payment_date'].toString();
      }

      final List<Map<String, dynamic>> results = [];
      for (var area in areas) {
        final areaId = area['id'].toString();
        results.add({
          'id': areaId, 'raw_id': area['id'], 'name': area['name']?.toString() ?? 'منطقة غير مسمى',
          'parent_id': area['parent_id'], 'revenue': recursiveRevenue[areaId] ?? 0.0,
          'profit': recursiveProfit[areaId] ?? 0.0, 'vendor_count': recursiveVendors[areaId] ?? 0,
          'debt': recursiveDebt[areaId] ?? 0.0, 'color': _getAreaColor(results.length),
        });
      }
      results.sort((a, b) => (b['revenue'] as double).compareTo(a['revenue'] as double));

      if (mounted) {
        setState(() {
          _areaStats = results;
          _globalLifetimeProfit = globalProfit;
          _lastAreaPayments = lastPayments;
          _isLoading = false;
        });
      }
    } catch (e) {
      debugPrint("Error: $e");
      if (mounted) setState(() => _isLoading = false);
    }
  }

  Future<void> _selectDateRange() async {
    final picked = await showDateRangePicker(
      context: context,
      firstDate: DateTime(2023),
      lastDate: DateTime.now(),
      initialDateRange: _dateRange,
      builder: (context, child) {
        return Theme(
          data: ThemeData.dark().copyWith(
            colorScheme: const ColorScheme.dark(
              primary: Color(0xFFD00030),
              onPrimary: Colors.white,
              surface: Color(0xFF1E1E2C),
              onSurface: Colors.white,
            ),
            dialogBackgroundColor: const Color(0xFF0F0F1A),
          ),
          child: child!,
        );
      },
    );
    if (picked != null) {
      setState(() => _dateRange = picked);
      _loadData();
    }
  }

  Color _getAreaColor(int index) {
    List<Color> colors = [
      const Color(0xFFD00030),
      const Color(0xFF1E88E5),
      const Color(0xFF43A047),
      const Color(0xFFFB8C00),
      const Color(0xFF8E24AA),
      const Color(0xFF00ACC1),
    ];
    return colors[index % colors.length];
  }

