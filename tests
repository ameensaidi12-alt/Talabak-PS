                  crossAxisAlignment: CrossAxisAlignment.end,
                  children: [
                    Text("₪${p['amount']}", style: GoogleFonts.cairo(color: Colors.green, fontWeight: FontWeight.bold, fontSize: 16)),
                    const Icon(Icons.check_circle, color: Colors.green, size: 16),
