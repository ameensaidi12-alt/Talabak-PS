                ),
              ),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx, false),
            child: Text("إلغاء", style: GoogleFonts.cairo(color: Colors.white38)),
          ),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
              backgroundColor: widget.baseColor,
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
            ),
            onPressed: () {
              notes = notesController.text.trim().isEmpty ? null : notesController.text.trim();
              final amountStr = amountController.text.trim();
              if (amountStr.isEmpty) {
                 ScaffoldMessenger.of(ctx).showSnackBar(const SnackBar(content: Text("يرجى إدخال المبلغ")));
                 return;
              }
              amount = double.tryParse(amountStr) ?? 0;
              
              final currentDebt = currentBalance < 0 ? currentBalance.abs() : 0.0;
              
              if (amount > currentDebt + 0.05) { 
                ScaffoldMessenger.of(ctx).showSnackBar(SnackBar(
                  backgroundColor: Colors.redAccent,
                  content: Text("عذراً، لا يمكن تجاوز قيمة الدين (₪${currentDebt.toStringAsFixed(1)})", style: GoogleFonts.cairo(fontWeight: FontWeight.bold)),
                ));
                return;
              }
              Navigator.pop(ctx, true);
            },
            child: Text("تسجيل الدفعة", style: GoogleFonts.cairo(color: Colors.white, fontWeight: FontWeight.bold)),
          ),
        ],
      ),
    );

    if (confirmed != true || !mounted) return;

    setState(() => _isAddingPayment = true);
    try {
      await _supabaseService.addVendorPaymentRecord(
        widget.vendor['id'].toString(),
        picked,
        amount: amount,
        notes: notes,
      );
      
      setState(() {
        currentBalance += amount;
      });

      await _loadData();
      widget.onRefresh?.call();
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text("خطأ: $e")));
      }
    }
    if (mounted) setState(() => _isAddingPayment = false);
  }

  Future<void> _deleteRecord(String recordId) async {
    final ok = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: const Color(0xFF1E1E2C),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
        title: Text("حذف الدفعة", style: GoogleFonts.cairo(color: Colors.white, fontWeight: FontWeight.bold)),
        content: Text("هل تريد حذف هذا السجل؟", style: GoogleFonts.cairo(color: Colors.white70)),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx, false), child: Text("إلغاء", style: GoogleFonts.cairo(color: Colors.white38))),
          ElevatedButton(
            style: ElevatedButton.styleFrom(backgroundColor: Colors.red),
            onPressed: () => Navigator.pop(ctx, true),
            child: Text("حذف", style: GoogleFonts.cairo(color: Colors.white)),
          ),
        ],
      ),
    );
    if (ok != true) return;
    try {
      final record = _paymentRecords.firstWhere((r) => r['id'].toString() == recordId);
      final amount = double.tryParse(record['amount'].toString()) ?? 0;
      await _supabaseService.deleteVendorPaymentRecord(recordId);
      setState(() {
        currentBalance -= amount;
      });
      await _loadData();
      widget.onRefresh?.call();
    } catch (e) {
      if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text("خطأ: $e")));
    }
  }

