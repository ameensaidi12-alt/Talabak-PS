class _AreaDetailScreenState extends State<AreaDetailScreen> {
  final _supabaseService = SupabaseService();
  bool _isLoading = true;
  bool _includeSubAreas = false;
  Map<String, dynamic>? _supervisor;
  List<Map<String, dynamic>> _vendors = [];
  List<Map<String, dynamic>> _subAreas = [];
  List<Map<String, dynamic>> _logs = [];
  double _totalRevenue = 0;
  Map<String, dynamic> _stats = {};
  Map<String, Map<String, double>> _areaBreakdown = {};
  List<Map<String, dynamic>> _allAreasList = [];
  DateTimeRange? _dateRange;
  double _totalPaidInArea = 0.0;
  double _totalPaidInAreaLifetime = 0.0;
  final TextEditingController _searchController = TextEditingController();

  @override
  void dispose() {
    _searchController.dispose();
    super.dispose();
  }

  @override
  void initState() {
    super.initState();
    _loadDetailData();
  }

  Future<void> _loadDetailData({bool silent = false}) async {
    if (!mounted) return;
    if (!silent) setState(() => _isLoading = true);
    try {
      final currentAreaId = widget.rawAreaId;
      final allRelevantAreaIds = await _supabaseService.getRecursiveSubAreaIds(currentAreaId.toString());
      final allAreasRes = await _supabaseService.getDeliveryAreas();

      final results = await Future.wait([
        _supabaseService.client.from('profiles').select().eq('assigned_area_id', currentAreaId).eq('role', 'supervisor').limit(1),
        _supabaseService.client.from('vendors').select('*, profiles:owner_id(full_name, phone)'),
        _supabaseService.client.from('commission_change_logs').select('*, vendors(name), profiles:changed_by(full_name)').order('created_at', ascending: false),
        _supabaseService.client.from('orders').select('subtotal, commission_rate, vendor_id, vendors(name, area_id)').eq('status', 'delivered'),
        _supabaseService.client.from('vendor_payment_records').select('amount, created_at, vendor_id, vendors(area_id)'),
      ]);

      final supervisorRes = (results[0] as List).isNotEmpty ? results[0].first : null;
      final List<Map<String, dynamic>> allVendorsRaw = List<Map<String, dynamic>>.from(results[1] as List);
      final List<Map<String, dynamic>> allLogsRaw = List<Map<String, dynamic>>.from(results[2] as List);
      final List<Map<String, dynamic>> allOrdersRaw = List<Map<String, dynamic>>.from(results[3] as List);
      final List<Map<String, dynamic>> allPaymentsRaw = List<Map<String, dynamic>>.from(results[4] as List);

      List<Map<String, dynamic>> filteredVendors = allVendorsRaw.where((v) => _includeSubAreas ? allRelevantAreaIds.contains(v['area_id']?.toString()) : v['area_id']?.toString() == currentAreaId.toString()).toList();
      
      double rev = 0;
      double totalComm = 0;
      Map<String, Map<String, double>> breakdown = {};
      for (var aid in allRelevantAreaIds) {
        breakdown[aid] = {'rev': 0.0, 'prof': 0.0, 'paid': 0.0};
      }

      for (var o in allOrdersRaw) {
        final aid = o['vendors']?['area_id']?.toString();
        if (_includeSubAreas ? allRelevantAreaIds.contains(aid) : aid == currentAreaId.toString()) {
          double sub = (o['subtotal'] as num? ?? 0).toDouble();
          double rate = (o['commission_rate'] as num? ?? 2.0).toDouble();
          double prof = (sub * rate / 100);
          rev += sub;
          totalComm += prof;
          if (aid != null && breakdown.containsKey(aid)) {
            breakdown[aid]!['rev'] = (breakdown[aid]!['rev'] ?? 0) + sub;
            breakdown[aid]!['prof'] = (breakdown[aid]!['prof'] ?? 0) + prof;
          }
        }
      }

      double totalPaidF = 0;
      double totalPaidL = 0;
      for (var p in allPaymentsRaw) {
        final aid = p['vendors']?['area_id']?.toString();
        if (_includeSubAreas ? allRelevantAreaIds.contains(aid) : aid == currentAreaId.toString()) {
          double amt = (p['amount'] as num? ?? 0).toDouble();
          totalPaidL += amt;
          if (aid != null && breakdown.containsKey(aid)) {
            breakdown[aid]!['paid'] = (breakdown[aid]!['paid'] ?? 0) + amt;
          }
        }
      }

      if (mounted) {
        setState(() {
          _areaBreakdown = breakdown;
          _allAreasList = List<Map<String, dynamic>>.from(allAreasRes);
          _supervisor = supervisorRes;
          _vendors = filteredVendors;
          _subAreas = (allAreasRes as List).where((a) => a['parent_id']?.toString() == currentAreaId.toString()).toList().cast<Map<String, dynamic>>();
          _logs = allLogsRaw.where((l) => _includeSubAreas ? allRelevantAreaIds.contains(l['area_id']?.toString()) : l['area_id']?.toString() == currentAreaId.toString()).toList();
          _totalRevenue = rev;
          _totalPaidInAreaLifetime = totalPaidL;
          _stats = {'total_profit': totalComm};
          _isLoading = false;
        });
      }
    } catch (e) {
      debugPrint("Error: $e");
      if (mounted) setState(() => _isLoading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF0F0F1A),
      body: _isLoading 
        ? const Center(child: CircularProgressIndicator())
        : CustomScrollView(
            slivers: [
              SliverAppBar(
                expandedHeight: 200, pinned: true, backgroundColor: const Color(0xFF0F0F1A),
                flexibleSpace: FlexibleSpaceBar(
                  title: Text(widget.areaName, style: GoogleFonts.cairo(fontWeight: FontWeight.bold)),
                  background: Container(decoration: BoxDecoration(gradient: LinearGradient(colors: [widget.baseColor, const Color(0xFF0F0F1A)], begin: Alignment.topLeft, end: Alignment.bottomRight))),
                ),
                actions: [
                  IconButton(icon: const Icon(Icons.analytics_outlined), onPressed: _showAreaAuditCenter),
                ],
              ),
              SliverToBoxAdapter(
                child: Padding(
                  padding: const EdgeInsets.all(16),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      _buildQuickStatsRow(),
                      const SizedBox(height: 20),
                      _buildSectionTitle("المتاجر"),
                      ..._vendors.map((v) => _buildVendorItem(v)).toList(),
                    ],
                  ),
                ),
              ),
            ],
          ),
    );
  }

  Widget _buildQuickStatsRow() {
    return Row(
      children: [
        Expanded(child: _buildStatMiniCard("إجمالي الإيرادات", "₪${_totalRevenue.toStringAsFixed(0)}", Icons.payments, Colors.blue)),
        const SizedBox(width: 12),
        Expanded(child: _buildStatMiniCard("الربح المحقق", "₪${(_stats['total_profit'] ?? 0).toStringAsFixed(0)}", Icons.account_balance, Colors.green)),
